{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Router",
  "version": "0.1.0",
  "identifier": "ai.sohmtee.codex-router",
  "build": {
    "beforeDevCommand": "pnpm --filter @codex-router/control-panel dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @codex-router/control-panel build",
    "frontendDist": "../../control-panel/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{"label":"main","title":"Codex Router","width":1240,"height":840,"minWidth":680,"minHeight":560,"center":true,"resizable":true,"decorations":true,"visible":true}],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:4187; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true, "targets": ["nsis"], "category": "DeveloperTool",
    "shortDescription": "Local model routing for Codex",
    "longDescription": "A user-controlled local Codex model router and Windows control panel.",
    "windows": {"nsis": {"installMode": "currentUser", "displayLanguageSelector": false}}
  },
  "plugins": {
    "autostart": {"windows": {"runOnStartup": false}},
    "shell": {"open": true}
  }
}
